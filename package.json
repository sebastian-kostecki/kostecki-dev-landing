{
  "name": "kostecki-dev-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s generate:archive \"dev:app {@}\" --",
    "dev:app": "vite",
    "build": "run-s generate:icons generate:archive \"build:app {@}\" --",
    "build:app": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "build-only": "run-s \"build:client {@}\" build:ssr prerender --",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.ts --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "check:nginx": "bash scripts/check-nginx.sh",
    "format": "prettier --write --experimental-cli src/",
    "generate:icons": "node scripts/build-icons.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:archive": "node scripts/fetch-archive-count.mjs",
    "generate:og-image": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "^1.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
